# ==============================================================================
# AMQUANT Environment Configuration Template
# Copy to .env.local (frontend) and/or .env (backend) as appropriate.
# ==============================================================================

# Frontend Configuration (Vite)
# The base URL where the FastAPI backend service is accessible by the browser.
# In local development: http://localhost:8000
# In production: https://api.yourdomain.com
VITE_API_BASE_URL=http://localhost:8000

# Backend Configuration (FastAPI)
# Comma-separated allowed CORS origins for browser security.
# Leave empty or unset in local development to default to localhost origins.
# Example production value: https://amquant.yourdomain.com,https://yourname.github.io
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Server Port and Host
HOST=0.0.0.0
PORT=8000

