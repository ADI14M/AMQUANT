# ==============================================================================
# AMQUANT Environment Configuration Template
# Copy to .env.local (frontend) and/or .env (backend) as appropriate.
# ==============================================================================

# Frontend Configuration (Vite)
# The base URL where the FastAPI backend service is accessible by the browser.
# In local development: http://localhost:8000
# In production on Vercel: https://amquant-api.onrender.com (or your Render backend URL)
VITE_API_BASE_URL=http://localhost:8000

# Backend Configuration (FastAPI)
# Comma-separated allowed CORS origins for browser security.
# By default, https://amquant.vercel.app and localhost origins are always supported.
# Add custom domains if using a custom CNAME.
# Example production value: https://amquant.vercel.app,https://yourdomain.com
CORS_ORIGINS=https://amquant.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# Server Port and Host (used by Uvicorn in container / local)
HOST=0.0.0.0
PORT=8000


