# ==============================================================================
# AMQUANT Environment Configuration Template
# Copy to frontend/.env.local and/or backend/.env as appropriate.
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend Configuration (Vite - Vercel / Local)
# ------------------------------------------------------------------------------

# The base URL where the FastAPI backend service is accessible by the browser.
# In local development: http://localhost:8000
# In production on Vercel: https://amquant-api.onrender.com
VITE_API_BASE_URL=http://localhost:8000

# Supabase Project URL
# Found in: Supabase Dashboard -> Project Settings -> Configuration -> API -> Project URL
# Example: https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon / Publishable API Key (safe for browser)
# Found in: Supabase Dashboard -> Project Settings -> Configuration -> API -> Project API keys -> anon (public)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# ------------------------------------------------------------------------------
# Backend Configuration (FastAPI - Render / Local)
# ------------------------------------------------------------------------------

# Comma-separated allowed CORS origins for browser security.
# By default, https://amquant.vercel.app and localhost origins are always supported.
CORS_ORIGINS=https://amquant.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# Server Port and Host (used by Uvicorn in container / local)
HOST=0.0.0.0
PORT=8000

# Supabase Project URL (used by FastAPI for JWKS verification and PostgREST)
# Example: https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Key (used for PostgREST service gateway alongside caller's JWT)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Supabase JWT Secret (Optional if using JWKS, required for symmetric HS256 verification)
# Found in: Supabase Dashboard -> Project Settings -> Configuration -> API -> JWT Settings -> JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-string-here



